<Window x:Class="TempMailBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TempMailBox.ViewModels"
        xmlns:conv="clr-namespace:TempMailBox.Converters"
        Title="TempMailBox - 临时邮箱生成器"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa"
        Closed="Window_Closed">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>

        <!-- Accent Colors -->
        <Color x:Key="AccentColor">#4f46e5</Color>
        <Color x:Key="AccentLightColor">#6366f1</Color>
        <Color x:Key="SurfaceColor">#ffffff</Color>
        <Color x:Key="Surface2Color">#f0f1f5</Color>
        <Color x:Key="BorderColor">#d5d7e0</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4a5068"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8890a4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16a34a"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#dc2626"/>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#e8e9ef"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#eef0f5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Padding="24,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ffffff" Offset="0"/>
                    <GradientStop Color="#f0f1f8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📧" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TempMailBox" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="临时邮箱生成器" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Generate Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 生成邮箱" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding GenerateEmailCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                            Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Email Address Bar -->
        <Border Grid.Row="1" Padding="24,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="当前邮箱" 
                           Foreground="{StaticResource TextSecondary}" 
                           VerticalAlignment="Center" FontSize="13"
                           Margin="0,0,16,0"/>

                <!-- Email Display Card -->
                <Border Grid.Column="1" Background="#eef0ff" CornerRadius="8" Padding="16,8"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding CurrentEmail}" 
                               Foreground="{StaticResource AccentBrush}" 
                               FontSize="16" FontWeight="SemiBold"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>
                </Border>


                <Button Grid.Column="2"
                        Command="{Binding CopyEmailCommand}"
                        Margin="12,0,0,0"
                        Cursor="Hand"
                        FontSize="12"
                        Padding="16,8">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="📋 复制"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="#f0f1f5"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="1"
                                                BorderBrush="#d5d7e0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#e8e9ef"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#1a1a2e"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                    <Setter Property="Content" Value="✅ 已复制"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#16a34a"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderThickness="1"
                                                        BorderBrush="#16a34a">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="3" Content="🔃 刷新" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshMessagesCommand}"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Loading Overlay (shown when generating) -->
            <Border Background="#f5f6fa" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Welcome Screen (no account) -->
            <Border Visibility="{Binding HasAccount, Converter={StaticResource InverseBoolToVis}}"
                    Panel.ZIndex="5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <TextBlock Text="📬" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="欢迎使用临时邮箱" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="28" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="一键生成临时邮箱地址，自动接收邮件。&#x0a;适用于临时注册、测试、保护隐私等场景。" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="14" TextAlignment="Center" 
                               LineHeight="22" Margin="0,0,0,32"/>
                    <Button Content="✨ 立即生成临时邮箱" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding GenerateEmailCommand}"
                            HorizontalAlignment="Center"
                            Padding="32,14"
                            FontSize="15"/>
                </StackPanel>
            </Border>

            <!-- Email Content (has account) -->
            <Grid Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Message List -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Border Grid.Row="0" Padding="16,12" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="收件箱" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding MessageCount, StringFormat='({0})'}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Message List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Messages}"
                                 SelectedItem="{Binding SelectedMessage}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="16,12"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="{TemplateBinding Padding}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#f0f1f5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#e8eaff"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sender -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding FromDisplay}" 
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="{Binding Seen, Converter={StaticResource BoolToFontWeight}}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Time -->
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding DateDisplay}" 
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Subject -->
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                   Text="{Binding SubjectDisplay}" 
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"/>

                                        <!-- Preview -->
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                                   Text="{Binding Intro}" 
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="32"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" 
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding MessageCount, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="暂无邮件" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="每10秒自动刷新" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="11" HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                <!-- Right Panel: Message Detail -->
                <Border Grid.Column="2" Background="#f5f6fa">
                    <Grid>
                        <!-- No message selected -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding MessageDetail, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                            <TextBlock Text="📨" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="选择一封邮件查看详情" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Message detail view -->
                        <Grid Visibility="{Binding MessageDetail, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Message Header -->
                            <Border Grid.Row="0" Padding="24,16"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Background="{StaticResource SurfaceBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Subject -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding MessageDetail.SubjectDisplay}" 
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <!-- Delete button -->
                                    <Button Grid.Row="0" Grid.Column="1" 
                                            Content="🗑️" 
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding DeleteMessageCommand}"
                                            CommandParameter="{Binding MessageDetail}"
                                            ToolTip="删除此邮件"
                                            VerticalAlignment="Top"/>

                                    <!-- From -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                                                Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="发件人: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding MessageDetail.From.Address}" 
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Date -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" 
                                                Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="时间: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding MessageDetail.CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                                   Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Message Body -->
                            <ScrollViewer Grid.Row="1" 
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="24,16">
                                <TextBlock Text="{Binding MessageDetail.Text}" 
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           LineHeight="24"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Loading detail -->
                        <Border Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}"
                                Background="#CCf5f6fa"
                                Panel.ZIndex="5">
                            <TextBlock Text="加载中..." 
                                       Foreground="{StaticResource TextSecondary}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="24,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusText}" 
                           Foreground="{StaticResource TextSecondary}" 
                           FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text="Powered by mail.tm" 
                           Foreground="{StaticResource TextMuted}" 
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
